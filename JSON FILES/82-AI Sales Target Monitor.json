    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst requiredFields = [\n  \"Date\",\n  \"Salesperson_ID\",\n  \"Salesperson_Name\",\n  \"Region\",\n  \"Target_Sales\",\n  \"Actual_Sales\",\n  \"Target_Orders\",\n  \"Actual_Orders\"\n];\n\nconst validItems = [];\nconst invalidItems = [];\n\nfor (const item of items) {\n  const data = item.json;\n\n  const missingFields = requiredFields.filter(\n    field =>\n      data[field] === undefined ||\n      data[field] === null ||\n      String(data[field]).trim() === \"\"\n  );\n\n  if (missingFields.length === 0) {\n    validItems.push(data);\n  } else {\n    invalidItems.push({\n      salesperson_id: data.Salesperson_ID || \"Unknown\",\n      missing_fields: missingFields\n    });\n  }\n}\n\nreturn [\n  {\n    json: {\n      data_valid: invalidItems.length === 0,\n      total_records: items.length,\n      valid_records: validItems.length,\n      invalid_records: invalidItems.length,\n      invalid_details: invalidItems,\n      sales_data: validItems\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        -96
      ],
      "id": "af192095-62ac-48d0-a023-425cfd22c244",
      "name": "Validate Sales Data"
    },

      "name": "Is Sales Data Valid?"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze the following sales target data.\n\nSales Data:\n\n{{ JSON.stringify($json.sales_data) }}\n\nFor each salesperson calculate and analyze:\n\n- Sales achievement percentage\n- Order achievement percentage\n- Performance status\n- Performance gap\n- Recommended action\n- Reason based only on the provided numbers\n\nAlso provide:\n\n- Overall sales performance\n- Overall status\n- General recommendations\n\nReturn ONLY the required JSON structure.",
        "options": {
          "systemMessage": "You are an AI Sales Target Analyst.\n\nYour task is to analyze salesperson performance against assigned sales and order targets.\n\nFor each salesperson, evaluate:\n\n1. Target sales\n2. Actual sales\n3. Sales achievement percentage\n4. Target orders\n5. Actual orders\n6. Order achievement percentage\n7. Performance status\n8. Performance gap\n9. Recommended action\n\nUse these performance statuses:\n\nEXCEEDING:\nSales achievement is 100% or higher.\n\nON TRACK:\nSales achievement is between 90% and 99.99%.\n\nAT RISK:\nSales achievement is between 70% and 89.99%.\n\nBELOW TARGET:\nSales achievement is below 70%.\n\nDo not invent information.\n\nUse only the provided data.\n\nDo not assume reasons for poor performance unless the data supports them.\n\nReturn ONLY valid JSON.\n\nUse exactly this structure:\n\n{\n  \"overall_summary\": \"\",\n  \"salesperson_analysis\": [],\n  \"overall_status\": \"\",\n  \"recommendations\": []\n}"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        896,
        -96
      ],
      "id": "250836e7-22bb-4d37-865d-725511c67809",
      "name": "AI Sales Target Analyst"
    },
    {
      "parameters": {
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.1,
      "position": [
        968,
        136
      ],
      "id": "85bf70dd-df26-43bd-8f15-24cda4c80772",
      "name": "Google Gemini Chat Model",
      "credentials": {
        "googlePalmApi": {
          "id": "wkvPLR8iLkAneiWB",
          "name": "Google Gemini(PaLM) Api account 32"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const data = $json;\n\nlet result = data.output;\n\nif (typeof result !== \"string\") {\n  result = JSON.stringify(result);\n}\n\nresult = result\n  .replace(/```json/g, \"\")\n  .replace(/```/g, \"\")\n  .trim();\n\nlet parsed;\n\ntry {\n  parsed = JSON.parse(result);\n} catch (error) {\n  throw new Error(\"AI returned invalid JSON: \" + result);\n}\n\nreturn {\n  json: {\n    ...data,\n    ...parsed\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1248,
        -96
      ],
      "id": "3d944854-f9c4-4a3e-9393-a903d93620d6",
      "name": "Parse AI Result"
    },
    {
      "parameters": {
        "jsCode": "const data = $json;\n\nconst records = data.salesperson_analysis || [];\n\nreturn records.map(person => ({\n  json: {\n    report_id: `SALES-${Date.now()}-${person.salesperson_id}`,\n\n    report_date: new Date().toISOString().split(\"T\")[0],\n\n    salesperson_id: person.salesperson_id,\n    salesperson_name: person.salesperson_name,\n\n    sales_achievement: person.sales_achievement,\n    order_achievement: person.order_achievement,\n\n    performance_status: person.performance_status,\n\n    performance_gap: person.performance_gap,\n\n    recommendation: person.recommendation,\n\n    reason: person.reason,\n\n    overall_status: data.overall_status,\n\n    created_at: new Date().toISOString()\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1472,
        -96
      ],
      "id": "08736d7f-f567-44d1-b589-d3669dd4f6c2",
      "name": "Create Sales Target Record"
    },
    {
      "parameters": {
        "sendTo": "nachiketharroju@gmail.com",
        "subject": "=Sales Target Alert - {{ $json.salesperson_name }} - {{ $json.performance_status }}",
        "message": "=Hi Team,  The daily sales target monitoring system has generated a performance report.  Salesperson: {{ $json.salesperson_name }}  Salesperson ID: {{ $json.salesperson_id }}  Sales Achievement: {{ $json.sales_achievement }}%  Order Achievement: {{ $json.order_achievement }}%  Performance Status: {{ $json.performance_status }}  Performance Gap: ₹{{ $json.performance_gap }}  Reason: {{ $json.reason }}  Recommended Action: {{ $json.recommendation }}  Overall Status: {{ $json.overall_status }}  Please review the performance and take the appropriate action.  Best Regards, AI Sales Target Monitor",
        "options": {}
      },

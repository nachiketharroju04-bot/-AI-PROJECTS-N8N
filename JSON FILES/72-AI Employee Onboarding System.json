        "sendTo": "nachiketharroju@gmail.com",
        "subject": "=Welcome to the Team",
        "message": "=Hi {{ $json.employee_name }},  Welcome to the team!  We are excited to have you join us as a {{ $json.job_role }} in the {{ $json.department }} department.  Your manager: {{ $json.manager }}  Joining Date: {{ $json.joining_date }}  Here is your personalized onboarding plan.  FIRST DAY TASKS {{ $json.first_day_tasks }}  FIRST WEEK TASKS {{ $json.first_week_tasks }}  TRAINING {{ $json.training }}  PEOPLE TO MEET {{ $json.people_to_meet }}  ROLE-SPECIFIC TASKS {{ $json.role_specific_tasks }}  We wish you a great start!  Best Regards, HR Team",
        "options": {}

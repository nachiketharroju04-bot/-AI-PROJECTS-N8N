    {
      "parameters": {
        "promptType": "define",
        "text": "=Create an onboarding plan for this employee.\n\nEmployee Name:\n{{ $json[\"Employee Name\"] }}\n\nEmployee Email:\n{{ $json[\"Employee Email\"] }}\n\nDepartment:\n{{ $json[\"Department\"] }}\n\nJob Role:\n{{ $json[\"Job Role\"] }}\n\nJoining Date:\n{{ $json[\"Joining Date\"] }}\n\nManager:\n{{ $json[\"Manager Name\"] }}\n\nExperience Level:\n{{ $json[\"Experience Level\"] }}",
        "options": {
          "systemMessage": "You are an AI Employee Onboarding Planner.\n\nCreate a simple and practical onboarding plan for a new employee.\n\nUse only the employee information provided.\n\nCreate:\n1. Welcome message\n2. First-day tasks\n3. First-week tasks\n4. Training topics\n5. People to meet\n6. Role-specific tasks\n\nKeep the plan concise and realistic.\n\nDo not invent company policies, systems, or information that was not provided.\n\nReturn valid JSON only using this structure:\n\n{\n  \"welcome_message\": \"\",\n  \"first_day_tasks\": [],\n  \"first_week_tasks\": [],\n  \"training\": [],\n  \"people_to_meet\": [],\n  \"role_specific_tasks\": []\n}"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        672,
        -96
      ],
      "id": "026ddd3a-9ad6-470a-91c4-d7003d31b246",
      "name": "AI Onboarding Planner"
    },
    {
      "parameters": {
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.1,
      "position": [
        744,
        136
      ],
      "id": "fc777c16-aa5d-4479-a677-9203fe0553b6",
      "name": "Google Gemini Chat Model",
      "credentials": {
        "googlePalmApi": {
          "id": "MLSkGe5QY8eQGK3q",
          "name": "Google Gemini(PaLM) Api account 10"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const data = $json;\n\nlet result = data.output;\n\nif (typeof result === \"string\") {\n  result = result\n    .replace(/```json/g, \"\")\n    .replace(/```/g, \"\")\n    .trim();\n\n  result = JSON.parse(result);\n}\n\nreturn {\n  json: {\n    ...data,\n    ...result\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1024,
        -96
      ],
      "id": "d43133c8-f2c3-4e4c-8d25-655e889adc4b",
      "name": "Parse Onboarding Plan"
    },
    {
      "parameters": {
        "jsCode": "const data = $json;\n\nreturn {\n  json: {\n    employee_id: `EMP-${Date.now()}`,\n    employee_name: data[\"Employee Name\"],\n    employee_email: data[\"Employee Email\"],\n    department: data[\"Department\"],\n    job_role: data[\"Job Role\"],\n    joining_date: data[\"Joining Date\"],\n    manager: data[\"Manager Name\"],\n    experience_level: data[\"Experience Level\"],\n\n    welcome_message: data.welcome_message,\n\n    first_day_tasks: JSON.stringify(data.first_day_tasks),\n    first_week_tasks: JSON.stringify(data.first_week_tasks),\n    training: JSON.stringify(data.training),\n    people_to_meet: JSON.stringify(data.people_to_meet),\n    role_specific_tasks: JSON.stringify(data.role_specific_tasks),\n\n    onboarding_status: \"Not Started\",\n    created_at: new Date().toISOString()\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1248,
        -96
      ],
      "id": "443f270f-f12e-4c90-a5f2-199b62f86383",
      "name": "Create Onboarding Record"
    },

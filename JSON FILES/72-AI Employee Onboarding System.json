    {
      "parameters": {
        "jsCode": "const data = $json;\n\nconst requiredFields = [\n  \"Employee Name\",\n  \"Employee Email\",\n  \"Department\",\n  \"Job Role\",\n  \"Joining Date\",\n  \"Manager Name\",\n  \"Experience Level\"\n];\n\nconst missingFields = requiredFields.filter(\n  field =>\n    data[field] === undefined ||\n    data[field] === null ||\n    data[field] === \"\"\n);\n\nreturn [{\n  json: {\n    ...data,\n    data_valid: missingFields.length === 0,\n    missing_fields: missingFields\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        -96
      ],
      "id": "0f0e97dd-1d1b-45f7-ba90-9e1943137e70",
      "name": "Validate Employee Data"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "dcb08f02-a952-4a94-acff-c9289eb90bbb",
              "leftValue": "={{ $json.data_valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}

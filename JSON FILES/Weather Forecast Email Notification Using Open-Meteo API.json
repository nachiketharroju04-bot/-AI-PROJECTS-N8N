        "jsCode": "// Get the JSON from the previous node\nconst weather = $input.first().json;\n\n// Get the hourly temperature array\nconst temperatures = weather.hourly.temperature_2m;\n\n// Find the highest and lowest temperatures\nconst high = Math.max(...temperatures);\nconst low = Math.min(...temperatures);\n\n// Return the message\nreturn [\n  {\n    json: {\n      message: `In BANGLORE, the high today is ${high}°C and the low is ${low}°C.`\n    }\n  }\n];"
      },

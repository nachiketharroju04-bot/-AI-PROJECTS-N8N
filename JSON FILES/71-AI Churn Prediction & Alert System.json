    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const data = item.json;\n\n  const requiredFields = [\n    \"customer_id\",\n    \"customer_name\",\n    \"email\",\n    \"days_inactive\",\n    \"login_30d\",\n    \"login_90d\",\n    \"purchase_90d\",\n    \"support_tickets\",\n    \"unresolved_tickets\",\n    \"satisfaction\",\n    \"payment_failures\"\n  ];\n\n  const missingFields = requiredFields.filter(\n    field =>\n      data[field] === undefined ||\n      data[field] === null ||\n      data[field] === \"\"\n  );\n\n  return {\n    json: {\n      ...data,\n      data_valid: missingFields.length === 0,\n      missing_fields: missingFields\n    }\n  };\n});"
      },

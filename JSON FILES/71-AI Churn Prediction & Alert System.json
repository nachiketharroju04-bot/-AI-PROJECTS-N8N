    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const data = item.json;\n\n  return {\n    json: {\n      ...data,\n      prediction_id: `PRED-${Date.now()}-${data.customer_id}`,\n      prediction_date: new Date().toISOString(),\n      status: \"Open\"\n    }\n  };\n});"
      },
